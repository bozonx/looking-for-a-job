{
  "name": "looking-for-a-job",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "collect": "node --env-file-if-exists=.env scripts/collect.ts",
    "collect:remoteok": "node --env-file-if-exists=.env scripts/collect.ts remoteok",
    "pending": "node --env-file-if-exists=.env scripts/pending.ts",
    "dedupe": "node --env-file-if-exists=.env scripts/dedupe.ts",
    "score": "node --env-file-if-exists=.env scripts/score.ts",
    "rescore": "node --env-file-if-exists=.env scripts/score.ts --all",
    "validate": "node --env-file-if-exists=.env scripts/validate.ts",
    "typecheck": "tsc -p . && nuxi prepare app >/dev/null && tsc -p app/.nuxt/tsconfig.server.json --noEmit && tsc -p app/.nuxt/tsconfig.app.json --noEmit",
    "dev": "nuxt dev app",
    "ui:build": "nuxt build app",
    "insights": "node --env-file-if-exists=.env scripts/insights.ts",
    "fetch-page": "node --env-file-if-exists=.env scripts/fetch-page.ts",
    "top": "node --env-file-if-exists=.env scripts/top.ts",
    "cleanup": "node --env-file-if-exists=.env scripts/cleanup.ts",
    "check-alive": "node --env-file-if-exists=.env scripts/check-alive.ts"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "fast-xml-parser": "^5.12.1",
    "marked": "^18.2.0",
    "nuxt": "^4.6.4",
    "turndown": "^7.2.5",
    "vue": "^3.5.45",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
