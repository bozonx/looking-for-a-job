# сбор
COLLECT_MAX_PAGES=5
COLLECT_MAX_AGE_DAYS=30
COLLECT_STOP_ON_SEEN=5
COLLECT_MAX_NEW=300

# скоринг (агент)
SCORE_MAX_PER_RUN=50

# отклик
APPLY_SCORE_THRESHOLD=80
APPLY_MAX_PER_RUN=15
APPLY_CONFIRM_SCORED=true
LINKEDIN_APPLY_MAX_PER_DAY=5
APPLY_DELAY_MIN_SEC=60
APPLY_DELAY_MAX_SEC=240
TYPE_DELAY_MS=40
# пауза между полями формы при заполнении (scripts/browser.ts fill-many), мс
FILL_DELAY_MIN_MS=300
FILL_DELAY_MAX_MS=1500
# адрес отладки Chromium (npm run browser:start)
BROWSER_CDP_URL=http://127.0.0.1:9222

# очистка
CLEANUP_DEFAULT_DAYS=30
# после npm run collect: удалить вакансии без решения (нет статуса/★/⚑) старше CLEANUP_DEFAULT_DAYS
CLEANUP_ON_COLLECT=true
